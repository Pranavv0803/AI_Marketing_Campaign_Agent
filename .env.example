# OpenAI API Key (Required for live mode)
OPENAI_API_KEY="your-openai-api-key-here"

# Model Selection
WRITER_MODEL="gpt-4o-mini"
JUDGE_MODEL="gpt-4o-mini"

# Mock Mode (Set to "true" for zero-spend offline demos, "false" for live OpenAI API calls)
MOCK_LLM="false"

# Concurrency & Performance (Max parallel requests to OpenAI)
MAX_CONCURRENCY=3

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000"
